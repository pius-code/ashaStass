# Caspian SDK auth — https://trycaspianai.com
CASPIAN_API_KEY=
CASPIAN_BASE_URL=

# Telegram bot token
Telegram_bot=

# Discord bot token
DISCORD_BOT_TOKEN=

# Iris's own MCP server — usually just points at itself
CAAM_MCP=http://127.0.0.1:8000/mcp

# Only needed if you're wiring up the IoT side (ashaBackend) too
ASHA_MCP=

# MQTT broker Iris listens on for external events — must match whatever
# ashaBackend / your device actually publishes to. A public broker
# (e.g. broker.hivemq.com, port 1883) works for quick testing; use your
# own broker's address for anything real.
MQTT_IP=
MQTT_PORT=1883

# Model provider(s) — you only need ONE of these, pick whichever you're
# comfortable with. Both have generous free tiers.
GROQ_API_KEY=
OPEN_ROUTER_KEY=
